# Copiar a .env.local. Nunca subir valores reales al repositorio.
# Local: `npm run db:start` imprime estos valores.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Bold (fase de pagos)
BOLD_API_KEY=
BOLD_SECRET_KEY=
# Correo transaccional (Resend)
RESEND_API_KEY=
RESEND_FROM=Elite Barber & Tattoo <reservas@elite-barber-tatto.com>
SITE_URL=https://elite-barber-tatto.com
