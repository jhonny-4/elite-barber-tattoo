# Copiar a .env.local. Nunca subir valores reales al repositorio.
# Local: `npm run db:start` imprime estos valores.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Bold (fase de pagos)
BOLD_API_KEY=
BOLD_SECRET_KEY=
# Correo transaccional (Resend)
RESEND_API_KEY=
RESEND_FROM=Elite Barber & Tattoo <reservas@elite-barber-tatto.com>
SITE_URL=https://elite-barber-tatto.com
# Cron de avisos: POST /api/cron/tick con "Authorization: Bearer <CRON_SECRET>" (mín. 32 caracteres).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
# Enlace de reseñas de Google (https). Vacío: no se envía el correo de reseña.
GOOGLE_REVIEW_URL=
# Web Push del equipo. Generar: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
